{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuevamente.local/schemas/clean-document-1.0.json",
  "title": "NuevaMente Clean Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "tenant_id",
    "title",
    "language",
    "source",
    "pages",
    "extraction"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "document_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["file_name", "content_type"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1 },
        "content_type": { "const": "application/pdf" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "text"],
        "properties": {
          "page_number": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["parser", "warnings"],
      "properties": {
        "parser": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string" },
        "extracted_at": { "type": "string", "format": "date-time" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
